# --- Server ---
NODE_ENV=development
PORT=4000

# --- Database (matches docker-compose.yml) ---
DATABASE_URL=postgresql://sthir:sthir@localhost:5432/sthir?schema=public

# --- Auth ---
# Use a long random string in production (e.g. `openssl rand -hex 32`).
JWT_SECRET=change-me-to-a-long-random-secret
CORS_ORIGIN=http://localhost:5173
# Set to true in production (HTTPS).
COOKIE_SECURE=false
# Public URL of the web app; used to build password-reset links.
APP_URL=http://localhost:3000

# --- Registration ---
# invite (default) | open | closed. `invite` requires SIGNUP_INVITE_CODE below —
# if it is unset, registration is disabled rather than silently opened up.
SIGNUP_MODE=invite
SIGNUP_INVITE_CODE=change-this-invite-code

# --- Outbound email (password reset) ---
# console (default) prints the message to this server's log, so the reset flow is
# fully testable without a provider. Switch to `resend` for real delivery.
MAIL_PROVIDER=console
MAIL_FROM=Slate <onboarding@resend.dev>
# RESEND_API_KEY=re_xxxxxxxxxxxx

# --- Azure Blob Storage ---
AZURE_STORAGE_ACCOUNT=your_storage_account
AZURE_STORAGE_KEY=your_storage_account_key
AZURE_STORAGE_CONTAINER=attachments

# --- Bootstrap account seed (npm run seed) ---
# Only needed to create the very first account; others register in the app.
SEED_EMAIL=you@example.com
SEED_PASSWORD=change-this-password
