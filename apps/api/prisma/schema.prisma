generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(uuid()) @db.Uuid
  email        String       @unique
  displayName  String?      @map("display_name")
  passwordHash String       @map("password_hash")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  buckets      Bucket[]
  stacks       Stack[]
  notebooks    Notebook[]
  notes        Note[]
  attachments  Attachment[]
  sessions     Session[]
  resetTokens  PasswordResetToken[]
  writingDays  WritingDay[]

  @@map("users")
}

/**
 * A refresh-token session. The token itself is never stored — only its SHA-256 —
 * so a database leak cannot be replayed. Rows are the revocation list that a
 * bare JWT cannot provide: sign-out, "sign out everywhere" and password reset
 * all work by revoking here.
 */
model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  userAgent String?   @map("user_agent")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  lastUsedAt DateTime @default(now()) @map("last_used_at") @db.Timestamptz
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/** Single-use, short-lived password reset token (SHA-256 at rest, like sessions). */
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

/**
 * One row per calendar day the user wrote on. Kept as its own table because
 * note.updatedAt is overwritten on every edit and so cannot reconstruct history.
 * `day` is the user's LOCAL date, resolved client-side, so the streak matches
 * what the user experienced rather than UTC.
 */
model WritingDay {
  userId    String   @map("user_id") @db.Uuid
  day       String   @db.VarChar(10)
  noteCount Int      @default(1) @map("note_count")
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
  @@index([userId, updatedAt])
  @@map("writing_days")
}

model Bucket {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  title     String
  position  Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  stacks Stack[]

  @@index([userId, updatedAt])
  @@map("buckets")
}

model Stack {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  bucketId  String?   @map("bucket_id") @db.Uuid
  title     String
  position  Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  bucket    Bucket?    @relation(fields: [bucketId], references: [id], onDelete: SetNull)
  notebooks Notebook[]

  @@index([userId, updatedAt])
  @@index([bucketId])
  @@map("stacks")
}

model Notebook {
  id        String    @id @default(uuid()) @db.Uuid
  stackId   String    @map("stack_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  title     String
  position  Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  stack Stack @relation(fields: [stackId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes Note[]

  @@index([userId, updatedAt])
  @@index([stackId])
  @@map("notebooks")
}

model Note {
  id          String    @id @default(uuid()) @db.Uuid
  notebookId  String    @map("notebook_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  title       String
  contentJson Json      @map("content_json")
  contentText String?   @map("content_text")
  version     Int       @default(1)
  position    Int       @default(0)
  pinned      Boolean   @default(false)
  tags        String[]  @default([])
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz

  notebook    Notebook     @relation(fields: [notebookId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachments Attachment[]

  @@index([userId, updatedAt])
  @@index([notebookId])
  @@map("notes")
}

enum AttachmentKind {
  image
  pdf
}

enum AttachmentStatus {
  pending
  ready
}

model Attachment {
  id         String           @id @default(uuid()) @db.Uuid
  noteId     String           @map("note_id") @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  kind       AttachmentKind
  filename   String
  mimeType   String           @map("mime_type")
  byteSize   Int              @map("byte_size")
  checksum   String
  storageKey String           @map("storage_key")
  width      Int?
  height     Int?
  pageCount  Int?             @map("page_count")
  status     AttachmentStatus @default(pending)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime         @default(now()) @map("updated_at") @db.Timestamptz
  deletedAt  DateTime?        @map("deleted_at") @db.Timestamptz

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@index([noteId])
  @@index([checksum])
  @@map("attachments")
}
